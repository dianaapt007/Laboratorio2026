        static void Actividad2()
        {
            Console.WriteLine("Ingrese el código de la casa: ");
            string codigoCasa = Console.ReadLine();

            string[] datos = codigoCasa.Split('-'); //Separa cadenas
            string manzana = datos[0]; //datos en posición 0
            int numeroCasa = int.Parse(datos[1]); //.Parse -> convierte datos string a int

