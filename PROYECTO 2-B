namespace PROYECTO_2
{
    class Parcela
    {      
        public int mesParaCosechar = 0; //tiempo en que la planta está lista para ser cosechada
        public int edadMeses = 0; //tiempo en que avanza los meses
        public bool Fertilizante = false; //valida que parcela tiene fertilizante
        public bool plantaSembrada = false; //valida que parcela tiene una planta sembrada
        public double ingresoPlanta = 0; //variable de cuánto genera una planta en específico
        public string nombrePlanta = "Vacío"; //variable de nombre de la planta en específico
        public int mesesContando = 0; //contador de meses
        public bool modificadoPorFetiizante = false; //controlador que parcelas no reciban más del 10% de bono
        public Parcela()
        {
            LimpiarParcela();
        }
        public void LimpiarParcela ()
        {
            nombrePlanta = "Vacío";
            ingresoPlanta = 0;
            mesParaCosechar = 0;
            plantaSembrada = false;
            Fertilizante = false;
            edadMeses = 0;
            modificadoPorFetiizante = false;
        }        
        public void DefinirtipoPlanta() //procedure para definir tipo de planta en parcela seleccionada
        {            
            int opciontipoPlanta = 0;             
            while (true) //Validación del menú de tipos de plantas
            {
                Console.WriteLine("Ingrese tipo de planta a sembrar \n1. Maíz \n2. Zanahoria \n3. Lechuga \n4. Vacío"); //Seleccione opción de menú de tipos de planta
                if (int.TryParse(Console.ReadLine(), out opciontipoPlanta) && opciontipoPlanta >= 1 && opciontipoPlanta <= 4) //Validar la opcion ingresada sea un numero y esté en rango
                {
                    break;
                }
                Console.WriteLine("Opción inválida. Intente de nuevo");
            } 
            switch (opciontipoPlanta) //Asignar valores de nombre, ingreso, mes y plantaSembrada para parcela seleccionada
            {                
                case 1:
                    nombrePlanta = "Maíz";
                    ingresoPlanta = 700;
                    mesParaCosechar = 3; 
                    plantaSembrada = true;
                    Fertilizante = false;
                    break;
                case 2:
                    nombrePlanta = "Zanahoria";
                    ingresoPlanta = 500;
                    mesParaCosechar = 2; 
                    plantaSembrada = true;
                    Fertilizante = false;
                    break;
                case 3:
                    nombrePlanta = "Lechuga";
                    ingresoPlanta = 200; 
                    mesParaCosechar = 1;
                    plantaSembrada = true;
                    Fertilizante = false;
                    break;
                case 4:
                    nombrePlanta = "Vacío";
                    ingresoPlanta = 0;
                    mesParaCosechar = 0;
                    plantaSembrada = false;
                    Fertilizante = false; 
                    break;                
            }
            edadMeses = 0;
            if (nombrePlanta != "Vacío")
            {
                Console.WriteLine($"¡Parcela definida por {nombrePlanta} con éxito!");
            }
            else
            {
                Console.WriteLine("La parcela se mantendrá despejada.");
            }
        }                
    }
}

namespace PROYECTO_2
