                {
                    Console.WriteLine("Carácter inválido. Vuelva a intentar");
                    numEmpleados = 0;
                }
                else if (numEmpleados <= 0)
                    Console.WriteLine("Necesita al menos 1 empleado");
            } while (numEmpleados<=0);        
